# =============================================================================
# LearnHouse — exemplo de variáveis de ambiente.
#
# Forma recomendada: rode `./setup.sh` e ele gera este .env pra você (com os
# segredos preenchidos). Como alternativa, copie este arquivo para `.env` e
# edite manualmente:
#
#   cp .env.example .env
#   # gere os segredos:
#   openssl rand -base64 32   # use a saída em NEXTAUTH_SECRET
#   openssl rand -base64 32   # use em LEARNHOUSE_AUTH_JWT_SECRET_KEY
#   openssl rand -base64 32   # use em COLLAB_INTERNAL_KEY
#
# Cenário assumido: HTTPS/SSL é terminado na BORDA pelo seu Caddy. Aqui dentro
# roda HTTP puro, mas as variáveis públicas apontam para https:// para que
# cookies seguros, redirects e o WebSocket do collab funcionem no navegador.
#
# NÃO versione o .env gerado (ele contém segredos).
# =============================================================================

# -----------------------------------------------------------------------------
# Domain & Hosting
# -----------------------------------------------------------------------------
# Domínio público que os usuários digitam no navegador (servido pelo seu Caddy).
# Sem porta (TLS na borda usa 443). Ex: learnhouse.exemplo.com
LEARNHOUSE_DOMAIN=learnhouse.exemplo.com
# Porta do HOST (desta VM) que recebe do Caddy da borda. Seu Caddy faz
# reverse_proxy para http://<ip-desta-vm>:<HTTP_PORT>. Padrão 80.
HTTP_PORT=80

# -----------------------------------------------------------------------------
# Frontend (NEXT_PUBLIC_*) — injetados em runtime pelo server-wrapper.js
# -----------------------------------------------------------------------------
NEXT_PUBLIC_LEARNHOUSE_API_URL=https://learnhouse.exemplo.com/api/v1/
NEXT_PUBLIC_LEARNHOUSE_BACKEND_URL=https://learnhouse.exemplo.com/
NEXT_PUBLIC_LEARNHOUSE_DOMAIN=learnhouse.exemplo.com
# Últimos 2 rótulos do domínio (usado no escopo de cookie). Ex: exemplo.com
NEXT_PUBLIC_LEARNHOUSE_TOP_DOMAIN=exemplo.com
NEXT_PUBLIC_LEARNHOUSE_MULTI_ORG=False
NEXT_PUBLIC_LEARNHOUSE_DEFAULT_ORG=default
# True porque o TLS é servido na borda (Caddy).
NEXT_PUBLIC_LEARNHOUSE_HTTPS=True

# -----------------------------------------------------------------------------
# NextAuth
# -----------------------------------------------------------------------------
NEXTAUTH_URL=https://learnhouse.exemplo.com
NEXTAUTH_SECRET=CHANGE_ME_gere_com_openssl_rand_base64_32

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
# Banco local (serviço `db` do compose). Troque pela sua string se usar DB externo.
LEARNHOUSE_SQL_CONNECTION_STRING=postgresql://learnhouse:CHANGE_ME_SENHA_DB@db:5432/learnhouse
# Redis local (serviço `redis` do compose). Troque se usar Redis externo.
LEARNHOUSE_REDIS_CONNECTION_STRING=redis://redis:6379/learnhouse
LEARNHOUSE_REDIS_URL=redis://redis:6379
# Escopo dos cookies de sessão (precisa bater com o domínio público).
LEARNHOUSE_COOKIE_DOMAIN=.exemplo.com
LEARNHOUSE_PORT=9000

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
LEARNHOUSE_AUTH_JWT_SECRET_KEY=CHANGE_ME_gere_com_openssl_rand_base64_32
# Admin inicial — usado UMA ÚNICA VEZ, na primeira inicialização (banco vazio),
# pelo auto_install(). Depois disso, mudar estes valores não tem efeito.
LEARNHOUSE_INITIAL_ADMIN_EMAIL=admin@exemplo.com
LEARNHOUSE_INITIAL_ADMIN_PASSWORD=CHANGE_ME_SENHA_ADMIN
LEARNHOUSE_INITIAL_ORG_NAME=Default Organization
LEARNHOUSE_INITIAL_ORG_SLUG=default

# -----------------------------------------------------------------------------
# Collaboration Server (Yjs/Hocuspocus — edição em tempo real)
# -----------------------------------------------------------------------------
COLLAB_INTERNAL_KEY=CHANGE_ME_gere_com_openssl_rand_base64_32
NEXT_PUBLIC_COLLAB_URL=wss://learnhouse.exemplo.com/collab

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
LEARNHOUSE_DEVELOPMENT_MODE=False
LEARNHOUSE_LOGFIRE_ENABLED=False

# -----------------------------------------------------------------------------
# AI (opcional — deixe False se não for usar)
# -----------------------------------------------------------------------------
LEARNHOUSE_IS_AI_ENABLED=False
# Para habilitar: defina LEARNHOUSE_GEMINI_API_KEY=<sua-chave> e passe para True.
# LEARNHOUSE_GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Entrega de conteúdo
# -----------------------------------------------------------------------------
# filesystem = o conteúdo enviado fica no volume /app/api/content (do compose).
# Para S3: troque para s3api e defina LEARNHOUSE_S3_API_BUCKET_NAME (+ endpoint).
LEARNHOUSE_CONTENT_DELIVERY_TYPE=filesystem
# LEARNHOUSE_S3_API_BUCKET_NAME=
# LEARNHOUSE_S3_API_ENDPOINT_URL=

# -----------------------------------------------------------------------------
# Postgres (lidos pelo serviço `db` do compose) — só relevantes com banco local
# -----------------------------------------------------------------------------
POSTGRES_USER=learnhouse
POSTGRES_PASSWORD=CHANGE_ME_SENHA_DB
POSTGRES_DB=learnhouse

# -----------------------------------------------------------------------------
# (Opcional) Imagem do app — fixe versão para reprodutibilidade
# -----------------------------------------------------------------------------
# APP_IMAGE=ghcr.io/learnhouse/app:1.0.1
